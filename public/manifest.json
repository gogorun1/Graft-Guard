{
  "manifest_version": 3,
  "name": "Graft Guard",
  "version": "0.1.0",
  "description": "Compile stable web workflows into typed, cached, guarded tools.",
  "permissions": ["activeTab", "sidePanel", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Graft Guard"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
